{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user profile for RBAC",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["uid", "email", "role"]
    },
    "List": {
      "title": "List",
      "description": "A smart list",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "emoji": { "type": "string" },
        "color": { "type": "string" },
        "type": { "type": "string", "enum": ["solo", "shared"] },
        "participants": { "type": "array", "items": { "type": "string" } },
        "features": {
          "type": "object",
          "properties": {
            "planning": { "type": "boolean" },
            "shopping": { "type": "boolean" },
            "packing": { "type": "boolean" }
          }
        },
        "currency": { "type": "string" },
        "paymentMode": { "type": "string", "enum": ["detailed", "centralized"] },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "name", "type", "participants"]
    },
    "Person": {
      "title": "Person",
      "description": "A person in the group",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "order": { "type": "number" },
        "paidGroupIds": { "type": "array", "items": { "type": "string" } },
        "individualPayments": { "type": "object" }
      },
      "required": ["id", "name"]
    },
    "Group": {
      "title": "Group",
      "description": "A group of people",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "color": { "type": "string" },
        "peopleIds": { "type": "array", "items": { "type": "string" } },
        "organizerId": { "type": "string" },
        "order": { "type": "number" }
      },
      "required": ["id", "name", "color", "peopleIds"]
    },
    "Tag": {
      "title": "Tag",
      "description": "A category tag for items",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "emoji": { "type": "string" },
        "order": { "type": "number" }
      },
      "required": ["id", "name", "emoji"]
    },
    "Item": {
      "title": "Item",
      "description": "An item in the shopping list",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "quantity": { "type": "number" },
        "price": { "type": "number" },
        "groupId": { "type": "string" },
        "tagId": { "type": "string" },
        "photoId": { "type": "string" },
        "emoji": { "type": "string" },
        "details": { "type": "string" },
        "unit": { "type": "string" },
        "currency": { "type": "string" },
        "isBought": { "type": "boolean" },
        "isPacked": { "type": "boolean" },
        "paidById": { "type": "string" },
        "order": { "type": "number" }
      },
      "required": ["id", "name", "quantity", "price", "groupId"]
    },
    "CatalogItem": {
      "title": "CatalogItem",
      "description": "A template item in the master catalog",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "name": { "type": "string" },
        "emoji": { "type": "string" },
        "presentation": { "type": "string" },
        "unitType": { "type": "string" },
        "defaultCategory": { "type": "string" }
      },
      "required": ["id", "ownerId", "name"]
    }
  },
  "firestore": {
    "/master_catalog/{itemId}": {
      "schema": { "$ref": "#/entities/CatalogItem" },
      "description": "Master catalog templates per user"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles for RBAC"
    },
    "/lists/{listId}": {
      "schema": { "$ref": "#/entities/List" },
      "description": "Smart lists"
    },
    "/lists/{listId}/people/{personId}": {
      "schema": { "$ref": "#/entities/Person" },
      "description": "People in a specific list"
    },
    "/lists/{listId}/groups/{groupId}": {
      "schema": { "$ref": "#/entities/Group" },
      "description": "Groups in a specific list"
    },
    "/lists/{listId}/tags/{tagId}": {
      "schema": { "$ref": "#/entities/Tag" },
      "description": "Tags in a specific list"
    },
    "/lists/{listId}/items/{itemId}": {
      "schema": { "$ref": "#/entities/Item" },
      "description": "Items in a specific list"
    }
  }
}
